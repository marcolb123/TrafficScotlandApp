<!-- Traffic Scotland Application - Landscape Layout -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="12dp"
    android:background="#F5F7FA"
    tools:context=".MainActivity">

    <!-- Left Column: Controls (40% width) -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.4"
        android:fillViewport="true"
        android:layout_marginEnd="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Application Title -->
            <TextView
                android:id="@+id/titleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Traffic Scotland"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#163B65"
                android:gravity="center"
                android:layout_marginBottom="12dp" />

            <!-- Status Message -->
            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Press Start to load traffic incidents"
                android:textSize="14sp"
                android:textColor="#555555"
                android:gravity="center"
                android:padding="8dp"
                android:layout_marginBottom="8dp" />

            <!-- Road search input -->
            <EditText
                android:id="@+id/searchRoadInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Search road (e.g. M8)"
                android:inputType="textCapCharacters"
                android:singleLine="true"
                android:padding="12dp"
                android:layout_marginBottom="8dp" />

            <!-- Distance search heading -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Search Near Glasgow"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#163B65"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp" />

            <!-- Distance input -->
            <EditText
                android:id="@+id/distanceInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Distance in km"
                android:inputType="numberDecimal"
                android:singleLine="true"
                android:layout_marginBottom="8dp" />

            <!-- Search and reset buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/searchRoadButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="Search" />

                <Button
                    android:id="@+id/resetSearchButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="Show All" />
            </LinearLayout>

            <Button
                android:id="@+id/searchDistanceButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Find Nearby Traffic"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnShowMap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="View Traffic Map"
                android:layout_marginBottom="8dp" />

            <!-- Download Traffic Data Button -->
            <Button
                android:id="@+id/startButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Load Traffic Information"
                android:layout_marginBottom="8dp" />

        </LinearLayout>
    </ScrollView>

    <!-- Right Column: Traffic Incidents List (60% width) -->
    <ListView
        android:id="@+id/trafficListView"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.6"
        android:divider="#CCCCCC"
        android:dividerHeight="1dp"
        android:background="#FFFFFF"
        android:padding="8dp"
        android:clipToPadding="false" />

</LinearLayout>