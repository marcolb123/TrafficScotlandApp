<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:padding="20dp"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Dialog heading -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TRAFFIC INFORMATION"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#64748B"
            android:layout_marginBottom="12dp" />

        <!-- Road name -->
        <TextView
            android:id="@+id/detailRoad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Road"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#163B65"
            android:layout_marginBottom="5dp" />

        <!-- Incident type -->
        <TextView
            android:id="@+id/detailType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Incident Type"
            android:textSize="16sp"
            android:textColor="#475569"
            android:layout_marginBottom="18dp" />

        <!-- Description section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DESCRIPTION"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#64748B"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/detailDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Description"
            android:textSize="16sp"
            android:textColor="#1E293B"
            android:layout_marginBottom="20dp" />

        <!-- Impact section -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E2E8F0"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TRAFFIC IMPACT"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#64748B"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/detailImpact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Impact"
            android:textSize="16sp"
            android:textColor="#1E293B"
            android:layout_marginBottom="20dp" />

        <!-- Dates section -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E2E8F0"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="START DATE"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#64748B"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/detailStartDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Start Date"
            android:textSize="15sp"
            android:textColor="#1E293B"
            android:layout_marginBottom="18dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="END DATE"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#64748B"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/detailEndDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="End Date"
            android:textSize="15sp"
            android:textColor="#1E293B"
            android:layout_marginBottom="12dp" />

    </LinearLayout>

</ScrollView>